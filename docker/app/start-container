#!/usr/bin/env bash

set -e

READY="/var/www/html/storage/.setup-ready"
CONTAINER_ROLE="${CONTAINER_ROLE:-worker}"

if [ "$CONTAINER_ROLE" = "app" ]; then
    rm -f "$READY"

    echo "[app] Installing Composer dependencies..."
    composer install --no-interaction

    echo "[app] Installing NPM dependencies..."
    npm install

    echo "[app] Running migrations..."
    php /var/www/html/artisan migrate --force

    echo "[app] Building frontend assets..."
    npm run build

    touch "$READY"
    echo "[app] Setup complete."
else
    echo "[$CONTAINER_ROLE] Waiting for app setup..."
    timeout=300
    elapsed=0
    while [ ! -f "$READY" ]; do
        sleep 2
        elapsed=$((elapsed + 2))
        if [ $elapsed -ge $timeout ]; then
            echo "ERROR: App setup did not complete within ${timeout}s."
            exit 1
        fi
    done
    echo "[$CONTAINER_ROLE] App setup ready. Starting..."
fi

exec gosu app "$@"
